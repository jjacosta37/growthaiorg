# Copy to .env and fill in. docker-compose overrides DATABASE_URL / REDIS_URL for containers.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Serve /api/schema/ and /api/docs/. Unauthenticated, so it defaults to off in prod.
DJANGO_API_DOCS=true
DATABASE_URL=postgres://luka:luka@localhost:5433/luka
REDIS_URL=redis://localhost:6379/0

# Single admin user, created by `manage.py bootstrap`
LUKA_ADMIN_USERNAME=admin
LUKA_ADMIN_EMAIL=
LUKA_ADMIN_PASSWORD=change-me

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_WRITER=claude-sonnet-5
LLM_MODEL_OPUS=claude-opus-5-5

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=luka

# Reddit Agent: "apify" or "fake" (sample posts, no Apify spend)
REDDIT_SOURCE=apify

# Onboarding crawl
CRAWL_MAX_PAGES=40
CRAWL_DELAY_SECONDS=0.2

# Apify: renders JavaScript-only pages during onboarding; Reddit data from Milestone 3
APIFY_TOKEN=
APIFY_RENDER_ACTOR=apify/website-content-crawler

# Error reporting. Blank = disabled (the default for local work and tests).
# Sentry's free Developer plan covers a solo developer across unlimited projects.
SENTRY_DSN=
ENVIRONMENT=dev
# Frame locals make tracebacks richer but can carry crawled page text and draft bodies.
SENTRY_LOCAL_VARIABLES=false
