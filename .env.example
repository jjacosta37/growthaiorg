# Copy to .env and fill in. docker-compose overrides DATABASE_URL / REDIS_URL for containers.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://sift:sift@localhost:5433/sift
REDIS_URL=redis://localhost:6379/0

# Single admin user, created by `manage.py bootstrap`
SIFT_ADMIN_USERNAME=admin
SIFT_ADMIN_EMAIL=
SIFT_ADMIN_PASSWORD=change-me

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_WRITER=claude-sonnet-5

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sift

# Onboarding crawl
CRAWL_MAX_PAGES=40
CRAWL_DELAY_SECONDS=0.2

# Apify: renders JavaScript-only pages during onboarding; Reddit data from Milestone 3
APIFY_TOKEN=
APIFY_RENDER_ACTOR=apify/website-content-crawler
