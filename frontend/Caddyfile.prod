# Serves the built SPA on :80, plain HTTP. TLS ends in front of it, and /api/*, /admin/* and
# /static/* are routed to Django before requests reach this container.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Vite fingerprints everything under /assets/, so a file there never changes
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# Everything else (the app shell at any route, icons) is revalidated, or browsers keep
	# loading an old release. A matcher on the path, because `header` runs before try_files.
	@not_assets not path /assets/*
	header @not_assets Cache-Control "no-cache"

	# Client-side routes (/inbox, /agents/x, ...) all load the app shell
	try_files {path} /index.html
	file_server
}
